# Template runs without vendor keys. Real providers arrive through the issues.
PORT=8080
APP_ENV=development
CALL_MODE=mock
EXPO_PUBLIC_API_URL=http://localhost:8080
# Android emulator: http://10.0.2.2:8080. Physical device: your computer LAN address.
# Server-only, optional future adapters:
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
# Server-only Claude adapter configuration (1..1024 output tokens):
CLAUDE_MAX_TOKENS=512
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
DEEPGRAM_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUBLIC_BASE_URL=
DATABASE_URL=postgres://switchboard:switchboard@localhost:5432/switchboard?sslmode=disable
# Future policy defaults: real calls disabled, test destinations only.
ENABLE_REAL_CALLS=false
CALL_ALLOWED_NUMBERS=
MAX_CALL_SECONDS=180
MAX_CONCURRENT_CALLS=1
# Provider timeouts in milliseconds, 1..60000 (docs/costs.md):
TELEPHONY_TIMEOUT_MS=10000
STT_TIMEOUT_MS=10000
LLM_TIMEOUT_MS=30000
TTS_TIMEOUT_MS=30000
# Dated list prices for estimate-only usage.updated; dashboards are the bill.
USAGE_RATES_CHECKED_ON=2026-11-10
USAGE_RATE_TELEPHONY_USD_PER_MIN=0.014
USAGE_RATE_MEDIA_USD_PER_MIN=0.0044
USAGE_RATE_STT_USD_PER_MIN=0.0077
USAGE_RATE_LLM_INPUT_USD_PER_MTOK=2
USAGE_RATE_LLM_OUTPUT_USD_PER_MTOK=10
USAGE_RATE_TTS_USD_PER_1K_CHARS=0.04
