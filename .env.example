# Template runs without vendor keys. Real providers arrive through the issues.
PORT=8080
APP_ENV=development
CALL_MODE=mock
EXPO_PUBLIC_API_URL=http://localhost:8080
APP_ORIGIN=http://localhost:8081
# Android emulator: http://10.0.2.2:8080. Physical device: your computer LAN address.
# Server-only, optional future adapters:
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
# Server-only Claude adapter configuration (1..1024 output tokens):
CLAUDE_MAX_TOKENS=512
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
PUBLIC_BASE_URL=
DATABASE_URL=postgres://switchboard:switchboard@localhost:5432/switchboard?sslmode=disable
# Explicit call-start gate: exact true enables real starts; false is the default.
ENABLE_REAL_CALLS=false
# Empty follows ENABLE_REAL_CALLS. Exact true retains signed callbacks while
# new outbound dialing is disabled. Requires account/token/PUBLIC_BASE_URL.
TWILIO_WEBHOOKS_ENABLED=
CALL_ALLOWED_NUMBERS=
MAX_CALL_SECONDS=180
MAX_CONCURRENT_CALLS=1
