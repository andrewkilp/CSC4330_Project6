{
  "note": "Synthetic GET /v1/providers fixtures. Keys are fake sentinels that must never appear in a response.",
  "secret_sentinels": [
    "sk-test-SENTINEL",
    "AC-SENTINEL",
    "auth-SENTINEL",
    "dg-SENTINEL",
    "xi-SENTINEL"
  ],
  "cases": [
    {
      "name": "template defaults: no keys, real calling off",
      "env": { "CALL_MODE": "mock", "ENABLE_REAL_CALLS": "false" },
      "implemented": {
        "telephony": false,
        "stt": true,
        "llm": true,
        "tts": true
      },
      "outages": [],
      "expected": {
        "mode": "mock",
        "telephony": {
          "available": false,
          "reason": "Phone calling is not available in this server version yet."
        },
        "stt": {
          "available": false,
          "reason": "Speech recognition is not set up on this server."
        },
        "llm": {
          "available": false,
          "reason": "Reply generation is not set up on this server."
        },
        "tts": {
          "available": false,
          "reason": "Speech playback is not set up on this server."
        }
      }
    },
    {
