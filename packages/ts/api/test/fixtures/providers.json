        "telephony": true,
        "stt": true,
        "llm": true,
        "tts": true
      },
      "outages": [],
      "expected": {
        "mode": "mock",
        "telephony": {
          "available": false,
          "reason": "Phone calling is not set up on this server."
        },
        "stt": {
          "available": false,
          "reason": "Speech recognition is not set up on this server."
        },
        "llm": { "available": true },
        "tts": {
          "available": false,
          "reason": "Speech playback is not set up on this server."
        }
      }
    },
    {
      "name": "all configured but real calling switched off",
      "env": {
        "CALL_MODE": "real",
        "ENABLE_REAL_CALLS": "false",
        "TWILIO_ACCOUNT_SID": "AC-SENTINEL",
